{
  "name": "inference-chain-orbitdb",
  "version": "0.1.0",
  "description": "OrbitDB sidecar — distributed miner registry, job board, and reputation ledger for InferenceChain",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev":   "node --loader ts-node/esm src/index.ts"
  },
  "dependencies": {
    "@orbitdb/core":                "^4.0.0",
    "helia":                        "^6.0.22",
    "blockstore-level":             "^2.0.1",
    "libp2p":                       "^2.5.0",
    "@chainsafe/libp2p-gossipsub":  "^14.0.0",
    "@libp2p/tcp":                  "^10.0.0",
    "@libp2p/mdns":                 "^11.0.0",
    "@libp2p/identify":             "^3.0.0",
    "express":                      "^4.19.2",
    "@types/express":               "^4.17.21"
  },
  "devDependencies": {
    "typescript":  "^5.5.4",
    "ts-node":     "^10.9.2",
    "@types/node": "^22.0.0"
  }
}
